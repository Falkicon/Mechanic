# Mechanic Desktop Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED FOR RESEARCH COMMANDS
# ═══════════════════════════════════════════════════════════════════════════════

# Gemini API key for the research command (research.query)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model IDs research.query uses
# MECHANIC_GEMINI_FAST_MODEL=gemini-3-flash-preview
# MECHANIC_GEMINI_THINKING_MODEL=gemini-3-pro-preview

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: PATH OVERRIDES
# ═══════════════════════════════════════════════════════════════════════════════
# These are auto-detected but can be overridden if needed

# WoW installation root (contains _retail_, _beta_, _ptr_, etc.)
# MECHANIC_WOW_ROOT=C:/Program Files (x86)/World of Warcraft

# Extra WoW installations to search for diagnostic data (separated by ; on Windows, : elsewhere)
# MECHANIC_ADDITIONAL_WOW_ROOTS=D:/Programs/World of Warcraft

# Development folder (contains addon source code)
# MECHANIC_DEV_PATH=C:/Program Files (x86)/World of Warcraft/_dev_

# Data directory for Mechanic databases and cache
# MECHANIC_DATA_DIR=~/.mechanic/data

# Lua 5.1 executable for sandbox.* commands and the Python-to-Lua contract tests
# (default: desktop/bin or ~/.mechanic/bin, then PATH)
# MECHANIC_LUA=C:/path/to/lua.exe
